# ==============================================================================
# AIOps & ChatOps Incident Management Platform — Environment Configuration
# ==============================================================================

# Out-of-band Management Network Topology
HOST_CONTROL_PLANE_IP=10.42.0.1
MANAGEMENT_NETWORK=10.42.0.0/16

# VM Management IP Endpoints
WS_UBUNTU_IP=10.42.10.81
SRV_UBUNTU_IP=10.42.10.80
OPNSENSE_IP=10.42.0.254

# Observability Ports
VICTORIAMETRICS_PORT=8428
VICTORIALOGS_HTTP_PORT=9428
VICTORIALOGS_SYSLOG_PORT=5514
GRAFANA_PORT=3000
OPNSENSE_EXPORTER_PORT=8081

# VictoriaMetrics & VictoriaLogs Data Paths & Retention
VM_RETENTION_PERIOD=30d
VL_RETENTION_PERIOD=30d

# Grafana Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# OPNsense Exporter API Credentials
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=
OPNSENSE_INSECURE=true

# Core Microservice Container Image Tags (for Single-Service Rollback)
AIOPS_TAG=v0.1.0
TICKET_TAG=v0.1.0
REMEDIATION_TAG=v0.1.0
CHATOPS_TAG=v0.1.0

# RabbitMQ Credentials
RABBITMQ_DEFAULT_USER=ops_user
RABBITMQ_DEFAULT_PASS=ops_secret
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# PostgreSQL Credentials
POSTGRES_USER=ops_ticket
POSTGRES_PASSWORD=ops_ticket_pw
POSTGRES_DB=ops_incidents
POSTGRES_PORT=5432
